rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el usuario del almacén puede leer y escribir.
    function esAlmacen() {
      return request.auth != null
        && request.auth.token.email == 'cvalmacen3@surplus-komatsu.app';
    }
    match /{coleccion}/{id} {
      allow read, write: if esAlmacen()
        && coleccion in ['materiales', 'despachos', 'conteos'];
    }
  }
}
